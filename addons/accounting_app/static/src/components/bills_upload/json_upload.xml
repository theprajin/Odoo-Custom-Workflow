                            Upload Invoice
                        </button>
                    </t>        
                
                <!-- <textarea t-model="state.value" rows="10" cols="50" placeholder="Paste your JSON data here"></textarea>
                <button type="button" t-on-click="onJsonDataSubmit" class="btn btn-primary">
                    <t t-esc="props.linkText || 'Upload JSON Data'"/>
                </button> -->        
